# Telegram API credentials
API_ID=your_api_id
API_HASH=your_api_hash

# Application settings
DB_PATH=/app/data/hr-sorter.db
HTTP_PORT=3000
HEADLESS=true
CSRF_SECRET=your_32_chars_secret_here

# HeadHunter API credentials
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret

# Optional: Skip browser download on startup if already installed in Docker
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
